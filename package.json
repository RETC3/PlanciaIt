{
  "name": "planciait",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint typecheck && prettier --check .",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @planciait/db db:generate",
    "db:migrate": "turbo run build --filter=@planciait/db && pnpm --filter @planciait/db db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
